<%layout("/layouts/boilerplate")%>
<div class="container mt-4">
    <h2>Admin Dashboard</h2>
    <p>Welcome, <%= currUser.username %>! Here is the user management panel.</p>
    
    <div class="table-responsive mt-4">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (users.length > 0) { %>
                    <% for(let user of users) { %>
                        <tr>
                            <td><%= user.username %></td>
                            <td><%= user.email %></td>
                            <td>
                                <span class="badge <%= user.role === 'admin' ? 'bg-danger' : (user.role === 'owner' ? 'bg-success' : 'bg-primary') %>">
                                    <%= user.role %>
                                </span>
                            </td>
                            <td>
                                <% if(user._id.toString() !== currUser._id.toString()) { %>
                                    <button class="btn btn-sm btn-outline-danger" onclick="alert('Delete functionality not fully implemented yet.')">Delete</button>
                                <% } else { %>
                                    <span class="text-muted">Current User</span>
                                <% } %>
                            </td>
                        </tr>
                    <% } %>
                <% } else { %>
                    <tr>
                        <td colspan="4" class="text-center">No users found.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
